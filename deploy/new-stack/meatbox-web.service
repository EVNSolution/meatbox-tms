[Unit]
Description=Meatbox transition web gateway
After=network.target meatbox-gateway.service meatbox-api.service
Requires=meatbox-gateway.service meatbox-api.service

[Service]
Type=simple
User=meatbox-demo
Group=meatbox-demo
WorkingDirectory=/opt/meatbox-tms/current/web
EnvironmentFile=/etc/meatbox-tms/web.env
EnvironmentFile=/etc/meatbox-tms/owners.env
ExecStart=/usr/bin/node /opt/meatbox-tms/current/web/scripts/serve-legacy.mjs
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
