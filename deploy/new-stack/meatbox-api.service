[Unit]
Description=Meatbox Kotlin API
After=network.target meatbox-gateway.service
Requires=meatbox-gateway.service

[Service]
Type=simple
User=meatbox-demo
Group=meatbox-demo
WorkingDirectory=/opt/meatbox-tms/current/api
EnvironmentFile=/etc/meatbox-tms/api.env
ExecStart=/usr/bin/java -Xms32m -Xmx128m -XX:ActiveProcessorCount=2 -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=16m -jar /opt/meatbox-tms/current/api/meatbox-api.jar
UMask=0077
Restart=on-failure
RestartSec=3
MemoryMax=320M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meatbox-demo/resources
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
