SERVER_PORT=8081
MEATBOX_COMPAT_ENABLED=true
MEATBOX_LEGACY_API_ORIGIN=http://127.0.0.1:3001
MEATBOX_DISPATCH_DATA_DIR=/opt/meatbox-demo/datasets/0b7107924f0ce822a95125c4b7eb0c1498fc4ea7f066e76ce951bcdac1ed7005
MEATBOX_RESOURCES_ENABLED=true
MEATBOX_RESOURCE_DATABASE=/var/lib/meatbox-demo/resources/resources.sqlite
MEATBOX_PUBLIC_ORIGIN=https://3.36.96.156
MEATBOX_AUTH_ENABLED=false
MEATBOX_AUTH_ACCESS_FILE=/var/lib/meatbox-demo/access.json
MEATBOX_DISPATCH_ENABLED=false
MEATBOX_DISPATCH_STATE_DIR=/var/lib/meatbox-demo/dispatch-state
# Meatbox outbound (delivery-status). Empty base URL keeps messages in the outbox without sending.
# MEATBOX_API_BASE_URL=
# MEATBOX_API_TOKEN=
# MEATBOX_OUTBOX_INTERVAL_SECONDS=5
# Meatbox order intake (POST /api/meatbox/orders). Empty token keeps the endpoint absent.
# MEATBOX_INBOUND_TOKEN=
# MEATBOX_INBOUND_GROUP_COUNT=8
# Temperature terminal intake (POST /api/telemetry/temperature). Empty token keeps the endpoint absent.
# MEATBOX_TELEMETRY_TOKEN=
# MEATBOX_TELEMETRY_STALE_MINUTES=10
# MEATBOX_TELEMETRY_DEFAULT_KIND=
# MEATBOX_TELEMETRY_BATCH_SECONDS=60
# Route engine for ETA and stop order (demo only). Both empty keeps straight-line ETA and 2-opt order.
# MEATBOX_OSRM_BASE_URL=http://127.0.0.1:5005
# MEATBOX_VROOM_URL=http://127.0.0.1:3005/
