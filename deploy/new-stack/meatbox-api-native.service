[Unit]
Description=Meatbox native Kotlin API
After=network.target

[Service]
Type=simple
User=meatbox-demo
Group=meatbox-demo
WorkingDirectory=/opt/meatbox-tms/current/api
EnvironmentFile=/etc/meatbox-tms/api.env
ExecStart=/usr/bin/java -Xms32m -Xmx256m -XX:ActiveProcessorCount=2 -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=16m -jar /opt/meatbox-tms/current/api/meatbox-api.jar
UMask=0077
Restart=on-failure
RestartSec=3
MemoryMax=640M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/meatbox-demo/datasets/0b7107924f0ce822a95125c4b7eb0c1498fc4ea7f066e76ce951bcdac1ed7005
ReadWritePaths=/var/lib/meatbox-demo
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
