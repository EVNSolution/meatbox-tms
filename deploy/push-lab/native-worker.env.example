# Install as /etc/meatbox-push-lab/push-lab-worker.env, root:root 0600.
# Keep the exact approved FID list empty until ready to start the worker.
NODE_ENV=production
DB_PATH=/var/lib/meatbox-push-lab/push-lab.sqlite
WORKER_LOCK_PATH=/var/lib/meatbox-push-lab/worker.lock
WORKER_PAUSE_PATH=/var/lib/meatbox-push-lab/worker.pause
PUSH_LAB_SENDER_MODE=real
PUSH_LAB_REAL_FID_ALLOWLIST=
FIREBASE_PROJECT_ID=REPLACE_WITH_APPROVED_TEST_PROJECT_ID
BUILD_SHA=REPLACE_WITH_TESTED_COMMIT_SHA
