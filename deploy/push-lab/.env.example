COMPOSE_PROJECT_NAME=meatbox-push-lab
PUSH_LAB_IMAGE_TAG=local
PUSH_LAB_PORT=3300
PUSH_LAB_BUILD_SHA=local
PUSH_LAB_PUBLIC_ORIGIN=http://localhost:3300
# Generate with: openssl rand -base64 32
PUSH_LAB_EXCHANGE_KEYS=REPLACE_WITH_BASE64_32_BYTE_KEY
# Real sender input. Used only with compose.real-split.yaml.example.
PUSH_LAB_FIREBASE_CREDENTIALS=/absolute/path/to/approved-test-service-account.json
PUSH_LAB_FIREBASE_API_KEY=REPLACE_WITH_PUBLIC_FIREBASE_API_KEY
PUSH_LAB_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PUBLIC_FIREBASE_AUTH_DOMAIN
PUSH_LAB_FIREBASE_PROJECT_ID=REPLACE_WITH_PUBLIC_FIREBASE_PROJECT_ID
PUSH_LAB_FIREBASE_APP_ID=REPLACE_WITH_PUBLIC_FIREBASE_APP_ID
PUSH_LAB_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_PUBLIC_MESSAGING_SENDER_ID
PUSH_LAB_FIREBASE_VAPID_PUBLIC_KEY=REPLACE_WITH_PUBLIC_VAPID_KEY
PUSH_LAB_REAL_FID_ALLOWLIST=REPLACE_WITH_COMMA_SEPARATED_APPROVED_TEST_FIDS
