# Install as /etc/meatbox-push-lab/push-lab-web.env, root:root 0600.
# Do not put Firebase service-account credentials or FID allowlists here.
NODE_ENV=production
PORT=3300
PUSH_LAB_BIND_HOST=127.0.0.1
DB_PATH=/var/lib/meatbox-push-lab/push-lab.sqlite
PUSH_LAB_SENDER_MODE=mock
DEPLOYMENT_PROBE_DELIVERABLE=false
PUSH_LAB_ADMIN_AUTH_MODE=tms_session
PUSH_LAB_TMS_SESSION_URL=http://127.0.0.1:3001/api/session
PUSH_LAB_TMS_ALLOWED_USERNAMES=REPLACE_WITH_APPROVED_CANONICAL_USERNAME
PUBLIC_ORIGIN=https://3.36.96.156
ALLOWED_ORIGIN=https://3.36.96.156
PUSH_LAB_TRUSTED_PROXY_PEERS=127.0.0.1
BUILD_SHA=REPLACE_WITH_TESTED_COMMIT_SHA
SLOT=pilot
EXCHANGE_KEYS=REPLACE_WITH_RANDOM_BASE64_32_BYTE_KEY
FIREBASE_API_KEY=REPLACE_WITH_PUBLIC_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PUBLIC_FIREBASE_AUTH_DOMAIN
FIREBASE_PROJECT_ID=REPLACE_WITH_APPROVED_TEST_PROJECT_ID
FIREBASE_APP_ID=REPLACE_WITH_PUBLIC_FIREBASE_APP_ID
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_PUBLIC_MESSAGING_SENDER_ID
FIREBASE_VAPID_PUBLIC_KEY=REPLACE_WITH_PUBLIC_VAPID_KEY
# Change PUSH_LAB_SENDER_MODE to real only after the real worker is healthy.
