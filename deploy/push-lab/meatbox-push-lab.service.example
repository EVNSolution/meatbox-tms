[Unit]
Description=Meatbox Push Lab isolated mock pilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meatbox-push-lab
Group=meatbox-push-lab
WorkingDirectory=/opt/meatbox-push-lab/current
EnvironmentFile=/etc/meatbox-push-lab/push-lab.env
LoadCredential=admin-password.hash:/etc/meatbox-push-lab/admin-password.hash
Environment=PUSH_LAB_ADMIN_PASSWORD_HASH_FILE=%d/admin-password.hash
ExecStart=/opt/meatbox-push-lab/runtime/node-v26.3.1-linux-x64/bin/node server/all.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=65s
UMask=0077
StateDirectory=meatbox-push-lab
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryHigh=128M
MemoryMax=192M
CPUQuota=50%
Nice=10
TasksMax=64

[Install]
WantedBy=multi-user.target
