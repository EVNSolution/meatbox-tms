# Install as /etc/meatbox-push-lab/push-lab.env, owned by root:root, mode 0600.
# Never commit a populated copy. The service is intentionally mock-only.
NODE_ENV=production
PORT=3300
PUSH_LAB_BIND_HOST=127.0.0.1
DB_PATH=/var/lib/meatbox-push-lab/push-lab.sqlite
WORKER_LOCK_PATH=/var/lib/meatbox-push-lab/worker.lock
WORKER_PAUSE_PATH=/var/lib/meatbox-push-lab/worker.pause
PUSH_LAB_SENDER_MODE=mock
DEPLOYMENT_PROBE_DELIVERABLE=false
PUBLIC_ORIGIN=https://3.36.96.156
ALLOWED_ORIGIN=https://3.36.96.156
PUSH_LAB_TRUSTED_PROXY_PEERS=127.0.0.1
BUILD_SHA=REPLACE_WITH_TESTED_COMMIT_SHA
SLOT=pilot
EXCHANGE_KEYS=REPLACE_WITH_RANDOM_BASE64_32_BYTE_KEY
