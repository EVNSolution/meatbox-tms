{
  "name": "@meatbox/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "oxlint --config .oxlintrc.json .",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run build && npm test && npm run test:artifact",
    "serve:legacy": "node scripts/serve-legacy.mjs",
    "test": "node scripts/test.mjs",
    "test:artifact": "node --test test/fork-artifact.check.mjs"
  },
  "devDependencies": {
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
