{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": false,
    "node": false,
    "es2024": true
  },
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "import"
  ],
  "ignorePatterns": [
    ".runtime/**",
    "node_modules/**",
    "public/vendor/**",
    "public/combined/assets/vendor/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "../../tools/oxlint/anti-slop/src/selected-plugin.ts"
    }
  ],
  "rules": {
    "anti-slop/no-array-filter-map": "warn",
    "anti-slop/no-reduce-accumulator-copy": "warn",
    "anti-slop/no-reflect-apply": "warn",
    "anti-slop/no-reflect-get": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.js",
        "src/**/*.mjs",
        "src/**/*.ts",
        "src/**/*.mts",
        "public/**/*.js",
        "public/**/*.mjs",
        "combined/**/*.js",
        "combined/**/*.mjs",
        "combined/**/*.ts",
        "ui-layout/**/*.js",
        "ui-layout/**/*.mjs",
        "ui-layout/**/*.ts"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "import/no-nodejs-modules": "error"
      },
      "globals": {
        "maplibregl": "readonly",
        "MB": "readonly",
        "L": "readonly"
      }
    },
    {
      "files": [
        "scripts/**/*.js",
        "scripts/**/*.mjs",
        "scripts/**/*.ts",
        "scripts/**/*.mts",
        "test/**/*.js",
        "test/**/*.mjs",
        "test/**/*.ts",
        "test/**/*.mts",
        "vite.config.mjs",
        "**/*.test.mjs",
        "**/*.test.ts"
      ],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    }
  ]
}
